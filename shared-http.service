[Unit]
Description=Python HTTP Server serving /mnt/shared
After=network.target autofs.service
Requires=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/mnt/shared
ExecStart=/usr/bin/python3 -m http.server 8080 --directory /mnt/shared
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target